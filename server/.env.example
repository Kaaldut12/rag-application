PORT=5000
CLIENT_ORIGIN=http://localhost:5173
GEMINI_API_KEY=your_gemini_api_key_here

# Generation model options:
# - gemini-flash-latest (default rolling alias, currently maps to gemini-3.8-flash)
# - gemini-flash-lite-latest (fast, lightweight flash tier with higher free-tier limits)
# - gemini-3.5-flash
# - gemini-3.8-flash
GEMINI_MODEL=gemini-flash-latest

# Embedding model (default: gemini-embedding-001)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
